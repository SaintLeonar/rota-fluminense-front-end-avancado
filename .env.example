# Copie este arquivo para .env.local e reinicie o Vite após qualquer alteração.
# Variáveis VITE_* são incorporadas ao bundle e ficam públicas no navegador.
# Não inclua senhas, tokens, URL de banco ou outros segredos neste arquivo.
# A URL é resolvida pelo navegador: use localhost, nunca o hostname interno backend.
VITE_API_URL=http://localhost:5000
